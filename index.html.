<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>The Red Zone – Check In</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root { --red: #C0392B; --dark-red: #922B21; --light-red: #FADBD8; --black: #1a1a1a; --white: #ffffff; --gray: #f5f5f5; --border: #e0e0e0; --text: #222; --muted: #777; }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  body { font-family: 'Inter', sans-serif; background: var(--black); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 16px; }
  .phone-wrap { width: 100%; max-width: 390px; background: var(--white); border-radius: 28px; overflow: hidden; box-shadow: 0 32px 80px rgba(0,0,0,0.6); min-height: 600px; }
  .header { background: var(--red); padding: 32px 24px 24px; text-align: center; }
  .header-title { font-family: 'Bebas Neue', sans-serif; font-size: 52px; letter-spacing: 3px; color: var(--white); line-height: 1; }
  .header-sub { font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.75); margin-top: 4px; }
  .screen { display: none; padding: 28px 24px; }
  .screen.active { display: block; }
  h2 { font-size: 20px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
  .sub { font-size: 14px; color: var(--muted); margin-bottom: 24px; line-height: 1.5; }
  .btn { width: 100%; padding: 15px; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; border: none; letter-spacing: 0.3px; transition: transform 0.1s, opacity 0.1s; }
  .btn:active { transform: scale(0.98); opacity: 0.9; }
  .btn-red { background: var(--red); color: var(--white); margin-bottom: 12px; }
  .btn-outline { background: var(--white); color: var(--text); border: 1.5px solid var(--border); margin-bottom: 12px; }
  .btn-back { background: none; border: none; color: var(--muted); font-size: 13px; cursor: pointer; padding: 0; margin-bottom: 20px; display: flex; align-items: center; gap: 4px; }
  .divider { text-align: center; color: var(--muted); font-size: 13px; margin: 4px 0 16px; }
  .search { width: 100%; padding: 12px 16px; border: 1.5px solid var(--border); border-radius: 10px; font-size: 15px; font-family: 'Inter', sans-serif; outline: none; margin-bottom: 12px; color: var(--text); background: var(--gray); }
  .search:focus { border-color: var(--red); background: var(--white); }
  .name-list { max-height: 300px; overflow-y: auto; border: 1.5px solid var(--border); border-radius: 10px; }
  .name-item { padding: 13px 16px; font-size: 15px; cursor: pointer; border-bottom: 1px solid var(--border); color: var(--text); transition: background 0.1s; }
  .name-item:last-child { border-bottom: none; }
  .name-item:hover, .name-item:active { background: var(--light-red); color: var(--dark-red); }
  .new-link { text-align: center; margin-top: 16px; font-size: 13px; color: var(--muted); }
  .new-link span { color: var(--red); cursor: pointer; font-weight: 500; }
  .confirm-card { background: var(--gray); border-radius: 14px; padding: 20px; margin-bottom: 24px; border: 1.5px solid var(--border); }
  .confirm-avatar { width: 48px; height: 48px; border-radius: 50%; background: var(--red); color: var(--white); font-size: 18px; font-weight: 700; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; font-family: 'Bebas Neue', sans-serif; }
  .confirm-name { font-size: 18px; font-weight: 600; color: var(--text); text-align: center; margin-bottom: 14px; }
  .info-row { display: flex; justify-content: space-between; font-size: 13px; padding: 5px 0; border-bottom: 1px solid var(--border); }
  .info-row:last-child { border-bottom: none; }
  .info-label { color: var(--muted); }
  .info-value { color: var(--text); font-weight: 500; text-align: right; max-width: 60%; word-break: break-all; }
  .field-group { margin-bottom: 16px; }
  .field-label { font-size: 12px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; display: block; }
  .field-input { width: 100%; padding: 12px 14px; border: 1.5px solid var(--border); border-radius: 10px; font-size: 15px; font-family: 'Inter', sans-serif; outline: none; color: var(--text); background: var(--gray); }
  .field-input:focus { border-color: var(--red); background: var(--white); }
  .required { color: var(--red); }
  .success-wrap { text-align: center; padding: 12px 0; }
  .success-circle { width: 72px; height: 72px; border-radius: 50%; background: var(--red); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
  .check-svg { width: 32px; height: 32px; stroke: white; fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .success-title { font-family: 'Bebas Neue', sans-serif; font-size: 36px; letter-spacing: 2px; color: var(--text); margin-bottom: 8px; }
  .success-msg { font-size: 14px; color: var(--muted); line-height: 1.6; margin-bottom: 28px; }
  @media (max-width: 420px) { .phone-wrap { border-radius: 0; min-height: 100vh; } body { padding: 0; align-items: flex-start; } }
</style>
</head>
<body>
<div class="phone-wrap">
  <div class="header">
    <div class="header-title">The Red Zone</div>
    <div class="header-sub">Wednesday Night Check-In</div>
  </div>

  <div id="s-welcome" class="screen active">
    <h2>Welcome, brother!</h2>
    <p class="sub">Have you been to the Red Zone before?</p>
    <button class="btn btn-red" onclick="show('s-returning')">Yes — I've been here before</button>
    <div class="divider">or</div>
    <button class="btn btn-outline" onclick="show('s-new')">No — this is my first time</button>
  </div>

  <div id="s-returning" class="screen">
    <button class="btn-back" onclick="show('s-welcome')">← Back</button>
    <h2>Find your name</h2>
    <p class="sub">Scroll or type to search, then tap your name.</p>
    <input class="search" type="text" placeholder="Search your name..." oninput="filterNames(this.value)" id="name-search" autocomplete="off" />
    <div class="name-list" id="name-list"></div>
    <div class="new-link">Not on the list? <span onclick="show('s-new')">Sign in as new →</span></div>
  </div>

  <div id="s-confirm" class="screen">
    <button class="btn-back" onclick="show('s-returning')">← Back</button>
    <h2>Is this you?</h2>
    <p class="sub">Tap confirm to check in.</p>
    <div class="confirm-card">
      <div class="confirm-avatar" id="confirm-initials"></div>
      <div class="confirm-name" id="confirm-name-text"></div>
      <div id="confirm-info"></div>
    </div>
    <button class="btn btn-red" onclick="submitReturning()">Yes, check me in</button>
    <button class="btn btn-outline" onclick="show('s-returning')">Not me</button>
  </div>

  <div id="s-new" class="screen">
    <button class="btn-back" onclick="show('s-welcome')">← Back</button>
    <h2>Welcome, first-timer!</h2>
    <p class="sub">So glad you're here. Fill in your info below.</p>
    <div class="field-group">
      <label class="field-label">Full name <span class="required">*</span></label>
      <input class="field-input" type="text" id="new-name" placeholder="First and last name" autocomplete="name" />
    </div>
    <div class="field-group">
      <label class="field-label">Email address</label>
      <input class="field-input" type="email" id="new-email" placeholder="you@example.com" autocomplete="email" />
    </div>
    <div class="field-group">
      <label class="field-label">Phone number</label>
      <input class="field-input" type="tel" id="new-phone" placeholder="(562) 555-1234" autocomplete="tel" />
    </div>
    <div class="field-group">
      <label class="field-label">Birthday (month / day)</label>
      <input class="field-input" type="text" id="new-bday" placeholder="e.g. 8/11" />
    </div>
    <button class="btn btn-red" onclick="submitNew()">Submit &amp; check in</button>
  </div>

  <div id="s-done" class="screen">
    <div class="success-wrap">
      <div class="success-circle">
        <svg class="check-svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <div class="success-title" id="done-title">Checked In!</div>
      <p class="success-msg" id="done-msg"></p>
      <button class="btn btn-red" onclick="reset()">Done</button>
    </div>
  </div>
</div>

