let selectedMember = null;

function show(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if (id === 's-returning') renderNames('');
}

function getInitials(name) {
  return name.split(' ').filter(Boolean).slice(0,2).map(w => w[0].toUpperCase()).join('');
}

function renderNames(filter) {
  const list = document.getElementById('name-list');
  const f = filter.toLowerCase();
  const filtered = MEMBERS.filter(m => m.name.toLowerCase().includes(f));
  if (!filtered.length) {
    list.innerHTML = '<div style="padding:16px;text-align:center;font-size:14px;color:#999;">No match — try signing in as new.</div>';
    return;
  }
  list.innerHTML = filtered.map(m =>
    `<div class="name-item" onclick="selectMember('${m.name.replace(/'/g,"\\'")}')">${m.name}</div>`
  ).join('');
}

function filterNames(v) { renderNames(v); }

function selectMember(name) {
  selectedMember = MEMBERS.find(m => m.name === name);
  document.getElementById('confirm-name-text').textContent = name;
  document.getElementById('confirm-initials').textContent = getInitials(name);
  const info = document.getElementById('confirm-info');
  info.innerHTML = [
    selectedMember.email ? `<div class="info-row"><span class="info-label">Email</span><span class="info-value">${selectedMember.email}</span></div>` : '',
    selectedMember.phone ? `<div class="info-row"><span class="info-label">Phone</span><span class="info-value">${selectedMember.phone}</span></div>` : '',
    selectedMember.birthday ? `<div class="info-row"><span class="info-label">Birthday</span><span class="info-value">${selectedMember.birthday}</span></div>` : ''
  ].join('');
  show('s-confirm');
}

function splitName(fullName) {
  const parts = fullName.trim().split(' ');
  const firstName = parts[0];
  const lastName = parts.slice(1).join(' ');
  return { firstName, lastName };
}

function submitReturning() {
  const { firstName, lastName } = splitName(selectedMember.name);
  const payload = {
    type: 'Returning',
    firstName: firstName,
    lastName: lastName,
    email: selectedMember.email,
    phone: selectedMember.phone,
    birthday: selectedMember.birthday,
    timestamp: new Date().toLocaleString('en-US', {weekday:'long',year:'numeric',month:'long',day:'numeric',hour:'numeric',minute:'2-digit'})
  };
  sendData(payload);
  document.getElementById('done-title').textContent = 'Checked In!';
  document.getElementById('done-msg').textContent = 'Good to see you, ' + firstName + '. Glad you\'re here tonight.';
  show('s-done');
}

function submitNew() {
  const fullName = document.getElementById('new-name').value.trim();
  if (!fullName) { alert('Please enter your name.'); return; }
  const { firstName, lastName } = splitName(fullName);
  const payload = {
    type: 'NEW',
    firstName: firstName,
    lastName: lastName,
    email: document.getElementById('new-email').value.trim(),
    phone: document.getElementById('new-phone').value.trim(),
    birthday: document.getElementById('new-bday').value.trim(),
    timestamp: new Date().toLocaleString('en-US', {weekday:'long',year:'numeric',month:'long',day:'numeric',hour:'numeric',minute:'2-digit'})
  };
  sendData(payload);
  document.getElementById('done-title').textContent = 'Welcome!';
  document.getElementById('done-msg').textContent = 'So glad you joined us tonight, ' + firstName + '. We hope to see you again next Wednesday!';
  show('s-done');
}

function sendData(data) {
  fetch(SHEET_URL, { method: 'POST', body: JSON.stringify(data), mode: 'no-cors' }).catch(() => {});
}

function reset() {
  document.getElementById('name-search').value = '';
  ['new-name','new-email','new-phone','new-bday'].forEach(id => document.getElementById(id).value = '');
  selectedMember = null;
  show('s-welcome');
}

